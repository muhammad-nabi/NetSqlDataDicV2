@model DataDictionary.AspNetCore.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center">
    <h1 class="display-4 text-danger">Error</h1>
    <p class="lead">An error occurred while processing your request.</p>

    @if (Model?.ShowRequestId ?? false)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <hr />

    <p>
        <a asp-area="DataDictionary" asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
    </p>
</div>
