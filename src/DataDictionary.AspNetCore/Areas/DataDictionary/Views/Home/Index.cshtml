@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">SQL Server Data Dictionary</h1>
    <p class="lead">Manage and compare your database schema metadata</p>
</div>

<div class="row mt-5 g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Data Dictionary</h5>
                <p class="card-text">View and edit metadata for all database columns including purpose, notes, and business context.</p>
                <a href="@ViewBag.RoutePrefix/Dictionary" class="btn btn-primary">View Dictionary</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Sync Database</h5>
                <p class="card-text">Synchronize the data dictionary with your source database to capture schema changes.</p>
                <a href="@ViewBag.RoutePrefix/Sync" class="btn btn-primary">Sync Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Compare Models</h5>
                <p class="card-text">Compare the data dictionary against EF Core models to identify differences.</p>
                <a href="@ViewBag.RoutePrefix/Comparison" class="btn btn-primary">Compare</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">EF Model Sources</h5>
                <p class="card-text">Configure DbContext DLLs for comparing database schema against EF Core models.</p>
                <a href="@ViewBag.RoutePrefix/Sources" class="btn btn-primary">Manage Sources</a>
            </div>
        </div>
    </div>
</div>
