@{
    ViewData["Title"] = "Data Dictionary";
    var servers = ViewBag.Servers as List<string> ?? new List<string>();
    var databases = ViewBag.Databases as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Data Dictionary</h2>
    <div>
        <span id="recordCount" class="text-muted me-3"></span>
        <a href="@ViewBag.RoutePrefix/Dictionary/ExportCsv" class="btn btn-outline-primary btn-sm me-2">
            Export CSV
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
            Clear Filters
        </button>
    </div>
</div>

<!-- Filter row -->
<div class="row mb-3">
    <div class="col-md-3">
        <input type="text" id="globalSearch" class="form-control form-control-sm" placeholder="Search all columns...">
    </div>
    <div class="col-md-2">
        <select id="serverFilter" class="form-select form-select-sm">
            <option value="">All Servers</option>
            @foreach (var server in servers)
            {
                <option value="@server">@server</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select id="databaseFilter" class="form-select form-select-sm">
            <option value="">All Databases</option>
            @foreach (var db in databases)
            {
                <option value="@db">@db</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
    <table id="dataDictionaryGrid" class="table table-striped table-hover table-sm" style="width:100%">
        <thead>
            <tr>
                <th>Table</th>
                <th>Column</th>
                <th>Type</th>
                <th>Null</th>
                <th>PK</th>
                <th>Purpose</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    var table = $('#dataDictionaryGrid').DataTable({
        processing: true,
        serverSide: true,
        scrollX: true,
        ajax: {
            url: '@ViewBag.RoutePrefix/Dictionary/Read',
            type: 'POST',
            contentType: 'application/json',
            data: function(d) {
                var sortCol = d.order && d.order[0] ? d.columns[d.order[0].column].data : null;
                var sortDir = d.order && d.order[0] ? d.order[0].dir : 'asc';

                return JSON.stringify({
                    page: Math.floor(d.start / d.length) + 1,
                    pageSize: d.length,
                    sortField: sortCol,
                    sortDirection: sortDir,
                    searchTerm: $('#globalSearch').val(),
                    filters: {
                        server: $('#serverFilter').val(),
                        database: $('#databaseFilter').val()
                    }
                });
            },
            dataSrc: function(json) {
                json.recordsTotal = json.total;
                json.recordsFiltered = json.total;
                $('#recordCount').text(json.total + ' records');
                return json.data;
            },
            beforeSend: function() {
                DataTableHelpers.showProgress(true);
            },
            complete: function() {
                DataTableHelpers.showProgress(false);
            }
        },
        columns: [
            {
                data: 'tableName',
                render: function(data, type, row) {
                    return '<span title="' + row.databaseServer + '/' + row.databaseName + '.' + row.schemaName + '">' +
                           row.schemaName + '.' + data + '</span>';
                }
            },
            { data: 'columnName' },
            {
                data: 'dataType',
                render: function(data, type, row) {
                    var fk = row.foreignKeyTo ? ' <span class="text-info" title="FK: ' + row.foreignKeyTo + '">&#128279;</span>' : '';
                    return data + fk;
                }
            },
            {
                data: 'isNullable',
                render: function(data) { return data ? 'Y' : 'N'; },
                className: 'text-center'
            },
            {
                data: 'isPrimaryKey',
                render: function(data) { return data ? '<span class="text-success">&#10003;</span>' : ''; },
                className: 'text-center'
            },
            {
                data: 'dataPurpose',
                className: 'editable-cell',
                render: function(data) { return data || '<em class="text-muted">-</em>'; }
            },
            {
                data: 'noteCount',
                className: 'text-center',
                render: function(data, type, row) {
                    if (data > 0) {
                        return '<a href="@ViewBag.RoutePrefix/Dictionary/Details/' + row.dataElementId + '" ' +
                               'class="badge bg-info text-decoration-none" title="View ' + data + ' note(s)">' +
                               data + '</a>';
                    }
                    return '<span class="text-muted">-</span>';
                }
            },
            {
                data: 'dataElementId',
                orderable: false,
                className: 'text-center',
                render: function(data, type, row) {
                    return '<a href="@ViewBag.RoutePrefix/Dictionary/Details/' + data + '" class="btn btn-sm btn-link p-0 me-2" title="View Details">Details</a>' +
                           '<button class="btn btn-sm btn-link p-0 edit-row-btn" data-id="' + data + '" title="Edit details">Edit</button>';
                }
            }
        ],
        columnDefs: [
            { width: '180px', targets: 0 },  // Table
            { width: '140px', targets: 1 },  // Column
            { width: '120px', targets: 2 },  // Type
            { width: '40px', targets: 3 },   // Null
            { width: '35px', targets: 4 },   // PK
            { width: '150px', targets: 5 },  // Purpose
            { width: '60px', targets: 6 },   // Notes count
            { width: '100px', targets: 7 }   // Actions
        ],
        pageLength: 50,
        lengthMenu: [[25, 50, 100, 200], [25, 50, 100, 200]],
        order: [[0, 'asc'], [1, 'asc']], // Default sort by Table, then Column
        searching: false, // We use our own search
        autoWidth: false,
        language: {
            processing: '<div class="spinner-border spinner-border-sm text-primary" role="status"></div>'
        }
    });

    // Global search with debounce
    var searchTimeout;
    $('#globalSearch').on('keyup', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() {
            table.ajax.reload();
        }, 300);
    });

    // Filter dropdowns
    $('#serverFilter, #databaseFilter').on('change', function() {
        table.ajax.reload();
    });

    // Inline editing for editable cells
    $('#dataDictionaryGrid').on('click', '.editable-cell', function() {
        var cell = $(this);
        if (cell.hasClass('editing')) return;

        var currentValue = cell.find('em').length > 0 ? '' : cell.text().trim();
        var input = $('<input type="text" class="form-control form-control-sm">').val(currentValue);

        cell.addClass('editing').html(input);
        input.focus().select();

        input.on('blur keydown', function(e) {
            if (e.type === 'blur' || e.key === 'Enter') {
                e.preventDefault();
                var newValue = input.val();

                if (newValue !== currentValue) {
                    var rowData = table.row(cell.closest('tr')).data();
                    var colIndex = cell.index();
                    var field = table.column(colIndex).dataSrc();
                    rowData[field] = newValue;

                    DataTableHelpers.showProgress(true);
                    $.ajax({
                        url: '@ViewBag.RoutePrefix/Dictionary/Update',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(rowData),
                        success: function(response) {
                            DataTableHelpers.showProgress(false);
                            if (response.success) {
                                cell.removeClass('editing').html(newValue || '<em class="text-muted">-</em>');
                            } else {
                                DataTableHelpers.alert('Failed to save: ' + (response.errors ? response.errors.join(', ') : 'Unknown error'));
                                cell.removeClass('editing').html(currentValue || '<em class="text-muted">-</em>');
                            }
                        },
                        error: function() {
                            DataTableHelpers.showProgress(false);
                            DataTableHelpers.alert('An error occurred while saving');
                            cell.removeClass('editing').html(currentValue || '<em class="text-muted">-</em>');
                        }
                    });
                } else {
                    cell.removeClass('editing').html(currentValue || '<em class="text-muted">-</em>');
                }
            }
            if (e.key === 'Escape') {
                cell.removeClass('editing').html(currentValue || '<em class="text-muted">-</em>');
            }
        });
    });
});

function clearFilters() {
    $('#globalSearch').val('');
    $('#serverFilter').val('');
    $('#databaseFilter').val('');
    $('#dataDictionaryGrid').DataTable().ajax.reload();
}
</script>
}
