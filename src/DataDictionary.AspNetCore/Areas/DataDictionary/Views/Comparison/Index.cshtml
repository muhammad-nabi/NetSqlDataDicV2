@model DataDictionary.AspNetCore.Core.Models.ViewModels.ComparisonResultViewModel
@{
    ViewData["Title"] = "EF Core Comparison";
    var sources = ViewBag.EfModelSources as List<EfModelSourceViewModel> ?? new List<EfModelSourceViewModel>();
    var selectedSourceId = ViewBag.SelectedSourceId as int?;
}

<style>
    .bg-purple { background-color: #6f42c1 !important; color: white !important; }
    .text-purple { color: #6f42c1 !important; }
    .btn-outline-purple { border-color: #6f42c1; color: #6f42c1; }
    .btn-outline-purple:hover { background-color: #6f42c1; color: white; }
</style>

<h2>Compare Data Dictionary with EF Core Models</h2>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Comparison Configuration</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">EF Model Source</label>
                    <select id="sourceSelector" class="form-select form-select-sm">
                        <option value="">-- Select a Source --</option>
                        @foreach (var source in sources)
                        {
                            if (selectedSourceId == source.Id)
                            {
                                <option value="@source.Id" data-server="@source.TargetServer" data-database="@source.TargetDatabase" selected>@source.Name (@source.TargetDisplay)</option>
                            }
                            else
                            {
                                <option value="@source.Id" data-server="@source.TargetServer" data-database="@source.TargetDatabase">@source.Name (@source.TargetDisplay)</option>
                            }
                        }
                    </select>
                    @if (sources.Count == 0)
                    {
                        <small class="text-muted">
                            No EF sources configured. <a href="@ViewBag.RoutePrefix/Sources/Create">Add one</a>
                        </small>
                    }
                </div>

                <dl class="row mb-3 small">
                    <dt class="col-sm-4">Server</dt>
                    <dd class="col-sm-8"><code id="displayServer">@ViewBag.SourceServer</code></dd>

                    <dt class="col-sm-4">Database</dt>
                    <dd class="col-sm-8"><code id="displayDatabase">@ViewBag.SourceDatabase</code></dd>
                </dl>

                @if (ViewBag.SourceName != null)
                {
                    <div class="alert alert-info py-2 mb-3 small">
                        Using source: <strong>@ViewBag.SourceName</strong>
                    </div>
                }

                <button type="button" id="runComparison" class="btn btn-primary btn-sm">
                    <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                    <span class="btn-text">Run Comparison</span>
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div id="summaryCard" class="card d-none">
            <div class="card-header">
                <h5 class="mb-0">Comparison Summary</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col">
                        <h3 id="matchCount" class="text-success mb-0">0</h3>
                        <small class="text-muted">Matches</small>
                    </div>
                    <div class="col">
                        <h3 id="missingEfCount" class="text-warning mb-0">0</h3>
                        <small class="text-muted">Missing in EF</small>
                    </div>
                    <div class="col">
                        <h3 id="missingDbCount" class="text-danger mb-0">0</h3>
                        <small class="text-muted">Missing in DB</small>
                    </div>
                    <div class="col">
                        <h3 id="mismatchCount" class="text-info mb-0">0</h3>
                        <small class="text-muted">Type Mismatches</small>
                    </div>
                    <div class="col">
                        <h3 id="constraintMismatchCount" class="text-purple mb-0">0</h3>
                        <small class="text-muted">Constraint Mismatches</small>
                    </div>
                    <div class="col">
                        <h3 id="skippedCount" class="text-secondary mb-0">0</h3>
                        <small class="text-muted">Skipped Tables</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <h6 class="mb-0">Comparison Results</h6>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary filter-btn active" data-filter="all">All</button>
            <button type="button" class="btn btn-outline-success filter-btn" data-filter="Match">Match</button>
            <button type="button" class="btn btn-outline-warning filter-btn" data-filter="MissingInEfModel">-EF</button>
            <button type="button" class="btn btn-outline-danger filter-btn" data-filter="MissingInDatabase">-DB</button>
            <button type="button" class="btn btn-outline-info filter-btn" data-filter="TypeMismatch">Type</button>
            <button type="button" class="btn btn-outline-purple filter-btn" data-filter="ConstraintMismatch">Constraint</button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="comparisonGrid" class="table table-striped table-hover table-sm mb-0" style="width:100%">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Table</th>
                        <th>Column</th>
                        <th>DB Type</th>
                        <th>EF Property</th>
                        <th>CLR Type</th>
                        <th>Constraint Details</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Select a source and click "Run Comparison" to see results
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Skipped Tables Section -->
<div id="skippedTablesSection" class="card mt-4 d-none">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <h6 class="mb-0">
            <a class="text-decoration-none text-reset"
               data-bs-toggle="collapse"
               href="#skippedTablesBody"
               role="button"
               aria-expanded="true">
                Tables Not in DbContext
                <span id="skippedTablesCount" class="badge bg-secondary ms-2">0</span>
            </a>
        </h6>
        <small class="text-muted">
            <span id="skippedColumnsCount">0</span> columns total
        </small>
    </div>
    <div class="collapse show" id="skippedTablesBody">
        <div class="card-body p-0">
            <div class="alert alert-info m-3 py-2 small mb-0">
                These tables exist in the Data Dictionary but have no corresponding entity in the DbContext.
                They may be intentionally excluded for security or other reasons.
            </div>
            <div class="table-responsive">
                <table id="skippedTablesGrid" class="table table-striped table-hover table-sm mb-0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Schema</th>
                            <th>Table Name</th>
                            <th>Columns</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var comparisonData = [];
    var skippedTablesData = [];
    var table = null;
    var skippedTable = null;
    var defaultServer = "@ViewBag.SourceServer";
    var defaultDatabase = "@ViewBag.SourceDatabase";

    $(document).ready(function () {
        // Source selector change handler
        $("#sourceSelector").on("change", function() {
            var selected = $(this).find("option:selected");
            if (selected.val()) {
                $("#displayServer").text(selected.data("server"));
                $("#displayDatabase").text(selected.data("database"));
            } else {
                $("#displayServer").text(defaultServer);
                $("#displayDatabase").text(defaultDatabase);
            }
        });

        // Run comparison button
        $("#runComparison").on("click", function () {
            var $btn = $(this);
            var $spinner = $btn.find(".spinner-border");
            var $text = $btn.find(".btn-text");
            var sourceId = $("#sourceSelector").val();

            if (!sourceId) {
                DataTableHelpers.alert("Please select an EF Model Source");
                return;
            }

            $btn.prop("disabled", true);
            $spinner.removeClass("d-none");
            $text.text("Comparing...");

            $.ajax({
                url: "@ViewBag.RoutePrefix/Comparison/CompareSource",
                type: "POST",
                data: { sourceId: sourceId },
                success: function (result) {
                    if (result.success) {
                        // Update summary
                        $("#summaryCard").removeClass("d-none");
                        $("#matchCount").text(result.totalMatches);
                        $("#missingEfCount").text(result.totalMissingInEf);
                        $("#missingDbCount").text(result.totalMissingInDb);
                        $("#mismatchCount").text(result.totalTypeMismatches);
                        $("#constraintMismatchCount").text(result.totalConstraintMismatches);
                        $("#skippedCount").text(result.totalSkippedTables);

                        // Store data and initialize/refresh grid
                        comparisonData = result.items;
                        initializeGrid(comparisonData);

                        // Handle skipped tables
                        skippedTablesData = result.skippedTables || [];
                        if (skippedTablesData.length > 0) {
                            $("#skippedTablesSection").removeClass("d-none");
                            $("#skippedTablesCount").text(result.totalSkippedTables);
                            $("#skippedColumnsCount").text(result.totalSkippedColumns);
                            initializeSkippedTablesGrid(skippedTablesData);
                        } else {
                            $("#skippedTablesSection").addClass("d-none");
                        }
                    } else {
                        DataTableHelpers.alert("Comparison failed: " + (result.error || "Unknown error"));
                    }
                },
                error: function (xhr, status, error) {
                    DataTableHelpers.alert("Error: " + error);
                },
                complete: function () {
                    $btn.prop("disabled", false);
                    $spinner.addClass("d-none");
                    $text.text("Run Comparison");
                }
            });
        });

        // Filter buttons
        $(".filter-btn").on("click", function () {
            $(".filter-btn").removeClass("active");
            $(this).addClass("active");

            var filter = $(this).data("filter");
            if (table) {
                if (filter === "all") {
                    table.clear().rows.add(comparisonData).draw();
                } else {
                    var statusValue = getStatusValue(filter);
                    var filtered = comparisonData.filter(function (item) {
                        return item.status === statusValue;
                    });
                    table.clear().rows.add(filtered).draw();
                }
            }
        });
    });

    function getStatusValue(statusName) {
        var statusMap = {
            "Match": 0,
            "MissingInEfModel": 1,
            "MissingInDatabase": 2,
            "TypeMismatch": 3,
            "ConstraintMismatch": 4
        };
        return statusMap[statusName] ?? -1;
    }

    function getStatusName(statusValue) {
        var statusNames = ["Match", "Missing in EF", "Missing in DB", "Type Mismatch", "Constraint Mismatch"];
        return statusNames[statusValue] || "Unknown";
    }

    function getStatusBadgeClass(statusValue) {
        var classes = ["bg-success", "bg-warning text-dark", "bg-danger", "bg-info text-dark", "bg-purple"];
        return classes[statusValue] || "bg-secondary";
    }

    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function initializeGrid(data) {
        // Destroy existing table if it exists
        if (table) {
            table.destroy();
        }

        table = $('#comparisonGrid').DataTable({
            data: data,
            scrollX: true,
            columns: [
                {
                    data: 'status',
                    render: function(data) {
                        return '<span class="badge ' + getStatusBadgeClass(data) + '" style="font-size:0.7rem">' + getStatusName(data) + '</span>';
                    }
                },
                {
                    data: 'tableName',
                    render: function(data, type, row) {
                        return '<span title="' + (row.schemaName || '') + '">' + (row.schemaName ? row.schemaName + '.' : '') + data + '</span>';
                    }
                },
                { data: 'columnName' },
                { data: 'databaseType', render: function(data) { return data || '-'; } },
                {
                    data: 'efPropertyName',
                    render: function(data, type, row) {
                        if (!data) return '-';
                        return '<span title="Entity: ' + (row.efEntityName || '') + '">' + data + '</span>';
                    }
                },
                { data: 'efClrType', render: function(data) { return data || '-'; } },
                {
                    data: 'constraintMismatchSummary',
                    render: function(data, type, row) {
                        if (!data) return '-';
                        return '<span class="text-muted small">' + escapeHtml(data) + '</span>';
                    }
                }
            ],
            columnDefs: [
                { width: '100px', targets: 0 },  // Status
                { width: '130px', targets: 1 },  // Table
                { width: '100px', targets: 2 },  // Column
                { width: '100px', targets: 3 },  // DB Type
                { width: '100px', targets: 4 },  // EF Property
                { width: '70px', targets: 5 },   // CLR Type
                { width: '250px', targets: 6 }   // Constraint Details
            ],
            autoWidth: false,
            pageLength: 50,
            lengthMenu: [[25, 50, 100, -1], [25, 50, 100, "All"]],
            order: [[1, 'asc'], [2, 'asc']], // Sort by Table, then Column
            language: {
                emptyTable: "No comparison results to display"
            }
        });
    }

    function initializeSkippedTablesGrid(data) {
        // Destroy existing table if it exists
        if (skippedTable) {
            skippedTable.destroy();
        }

        skippedTable = $('#skippedTablesGrid').DataTable({
            data: data,
            columns: [
                {
                    data: 'schemaName',
                    render: function(data) {
                        return '<code class="text-muted">' + (data || 'dbo') + '</code>';
                    }
                },
                {
                    data: 'tableName',
                    render: function(data) {
                        return '<code>' + data + '</code>';
                    }
                },
                {
                    data: 'columnCount',
                    className: 'text-center',
                    render: function(data) {
                        return '<span class="badge bg-secondary">' + data + '</span>';
                    }
                }
            ],
            columnDefs: [
                { width: '100px', targets: 0 },
                { width: 'auto', targets: 1 },
                { width: '100px', targets: 2 }
            ],
            autoWidth: false,
            pageLength: 10,
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
            order: [[0, 'asc'], [1, 'asc']],
            language: {
                emptyTable: "No skipped tables",
                info: "Showing _START_ to _END_ of _TOTAL_ skipped tables",
                infoEmpty: "No skipped tables",
                infoFiltered: "(filtered from _MAX_ total)"
            }
        });
    }
</script>
}
