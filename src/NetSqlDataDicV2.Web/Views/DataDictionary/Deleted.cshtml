@{
    ViewData["Title"] = "Deleted Columns";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Deleted Columns</h2>
    <div>
        <span id="recordCount" class="text-muted me-3"></span>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            Back to Dictionary
        </a>
    </div>
</div>

<div class="alert alert-info mb-3">
    <small>These columns were removed from the source database during sync. Click "Details" to view the audit history.</small>
</div>

<!-- Filter row -->
<div class="row mb-3">
    <div class="col-md-4">
        <input type="text" id="globalSearch" class="form-control form-control-sm" placeholder="Search table or column name...">
    </div>
</div>

<div class="table-responsive">
    <table id="deletedGrid" class="table table-striped table-hover table-sm" style="width:100%">
        <thead>
            <tr>
                <th>Table</th>
                <th>Column</th>
                <th>Type</th>
                <th>Deleted On</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    var table = $('#deletedGrid').DataTable({
        processing: true,
        serverSide: true,
        scrollX: true,
        ajax: {
            url: '@Url.Action("ReadDeleted", "DataDictionary")',
            type: 'POST',
            contentType: 'application/json',
            data: function(d) {
                var sortCol = d.order && d.order[0] ? d.columns[d.order[0].column].data : 'lastUpdateTime';
                var sortDir = d.order && d.order[0] ? d.order[0].dir : 'desc';

                return JSON.stringify({
                    page: Math.floor(d.start / d.length) + 1,
                    pageSize: d.length,
                    sortField: sortCol,
                    sortDirection: sortDir,
                    searchTerm: $('#globalSearch').val(),
                    filters: {}
                });
            },
            dataSrc: function(json) {
                json.recordsTotal = json.total;
                json.recordsFiltered = json.total;
                $('#recordCount').text(json.total + ' deleted column(s)');
                return json.data;
            },
            beforeSend: function() {
                DataTableHelpers.showProgress(true);
            },
            complete: function() {
                DataTableHelpers.showProgress(false);
            }
        },
        columns: [
            {
                data: 'tableName',
                render: function(data, type, row) {
                    return '<span class="text-decoration-line-through text-muted" title="' + row.databaseServer + '/' + row.databaseName + '.' + row.schemaName + '">' +
                           row.schemaName + '.' + data + '</span>';
                }
            },
            {
                data: 'columnName',
                render: function(data) {
                    return '<span class="text-decoration-line-through text-muted">' + data + '</span>';
                }
            },
            {
                data: 'dataType',
                render: function(data) {
                    return '<span class="text-muted">' + data + '</span>';
                }
            },
            {
                data: 'lastUpdateTime',
                render: function(data) {
                    if (!data) return '-';
                    var date = new Date(data);
                    return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
                }
            },
            {
                data: 'dataElementId',
                orderable: false,
                className: 'text-center',
                render: function(data) {
                    return '<a href="@Url.Action("Details", "DataDictionary")/' + data + '" class="btn btn-sm btn-outline-info" title="View History">Details</a>';
                }
            }
        ],
        columnDefs: [
            { width: '200px', targets: 0 },  // Table
            { width: '150px', targets: 1 },  // Column
            { width: '120px', targets: 2 },  // Type
            { width: '160px', targets: 3 },  // Deleted On
            { width: '80px', targets: 4 }    // Actions
        ],
        pageLength: 25,
        lengthMenu: [[25, 50, 100], [25, 50, 100]],
        order: [[3, 'desc']], // Default sort by Deleted On descending
        searching: false,
        autoWidth: false,
        language: {
            processing: '<div class="spinner-border spinner-border-sm text-primary" role="status"></div>',
            emptyTable: 'No deleted columns found'
        }
    });

    // Global search with debounce
    var searchTimeout;
    $('#globalSearch').on('keyup', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() {
            table.ajax.reload();
        }, 300);
    });
});
</script>
}
